#!/usr/bin/env python3
"""bin/feedback — append a dated feedback entry to docs/fork/feedback.md.

Usage:
    bin/feedback <short title>               # opens your editor with a dated skeleton
    bin/feedback <title> -m "quick note..."  # appends the note immediately, no editor

The skeleton records the current commit SHA (from `git`) and a timestamp; fill in
the details and save. Long-form write-ups belong in feedback-template.md and should
be linked here instead of being pasted in full.
"""
import argparse
import os
import subprocess
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.path.join(REPO, "docs", "fork", "feedback.md")

try:
    sha = subprocess.run(
        ["git", "-C", REPO, "rev-parse", "--short", "HEAD"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    branch = subprocess.run(
        ["git", "-C", REPO, "rev-parse", "--abbrev-ref", "HEAD"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
except subprocess.CalledProcessError:
    sha = "(not a git repo)"
    branch = "(n/a)"

TS = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def skeleton(title, message):
    entry = f"""---

## [{TS}] {title}

- **SHA:** `{sha}` (branch: {branch})
- **Date:** {TS}
- **Scenario / context:**
- **What I checked:**
- **Result:**
- **Notes:**

"""
    if message:
        entry += f"{message}\n"
    return entry + "---\n"


def main():
    parser = argparse.ArgumentParser(description="Append a dated feedback entry.")
    parser.add_argument("title", help="short title for the entry")
    parser.add_argument(
        "-m", "--message", help="note to append instead of opening an editor",
    )
    args = parser.parse_args()

    entry = skeleton(args.title, args.message)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as fh:
        fh.write(entry)

    print(f"Appended to {LOG}:")
    print(entry.strip())

    if not args.message:
        editor = os.environ.get("EDITOR", "nano")
        print(f"\nEditing with {editor} ...")
        subprocess.run([editor, LOG])

    print("Done.")


if __name__ == "__main__":
    main()
