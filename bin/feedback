#!/usr/bin/env python3
"""bin/feedback — append a dated feedback entry to docs/fork/feedback.md.

Usage:
    bin/feedback <short title>               # opens your editor with a dated skeleton
    bin/feedback <title> -m "quick note..."  # appends the note immediately, no editor

The skeleton records the current commit SHA (from `git`) and a timestamp; fill in
the details and save. Long-form write-ups belong in feedback-template.md and should
be linked here instead of being pasted in full.
"""
import os
import subprocess
import sys
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(ROOT)
LOG = os.path.join(REPO, "docs", "fork", "feedback.md")

try:
    sha = subprocess.run(
        ["git", "-C", REPO, "rev-parse", "--short", "HEAD"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    branch = subprocess.run(
        ["git", "-C", REPO, "rev-parse", "--abbrev-ref", "HEAD"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
except subprocess.CalledProcessError:
    sha = "(not a git repo)"
    branch = "(n/a)"

TS = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def parse_args(argv):
    title = ""
    message = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-m", "--message"):
            message = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            print(f"bin/feedback: unknown option: {a}")
            sys.exit(1)
        else:
            title = a
            i += 1
    return title, message


def skeleton(title, message):
    entry = f"""---

## [{TS}] {title}

- **SHA:** `{sha}` (branch: {branch})
- **Date:** {TS}
- **Scenario / context:**
- **What I checked:**
- **Result:**
- **Notes:**

"""
    if message:
        entry += f"{message}\n"
    return entry + "---\n"


def main():
    title, message = parse_args(sys.argv[1:])
    if not title:
        print("Usage: bin/feedback <short title> [-m/--message \"<message>\"]")
        sys.exit(1)

    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as fh:
        fh.write(skeleton(title, message))

    if message:
        print(f"Appended to {LOG}:")
        print(skeleton(title, message).strip())
        print("Done.")
        return

    editor = os.environ.get("EDITOR", "nano")
    print(f"Appended to {LOG}:")
    print(skeleton(title, message).strip())
    print(f"\nEditing with {editor} ...")
    subprocess.run([editor, LOG])

    print("Done.")


if __name__ == "__main__":
    main()
